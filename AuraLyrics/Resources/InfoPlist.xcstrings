            "state" : "translated",
            "value" : "AuraLyrics"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AuraLyrics memerlukan akses pustaka media untuk membaca judul lagu yang sedang diputar dan progres pemutaran agar dapat menyinkronkan lirik untuk Anda."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AuraLyrics memerlukan izin lokasi latar belakang untuk menjaga sinkronisasi lirik real-time di Layar Kunci dan Dynamic Island (hanya menggunakan keep-alive status kasar berdaya sangat rendah, dan tidak mengumpulkan atau mengunggah data lokasi)."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AuraLyrics memerlukan izin lokasi latar belakang untuk menjaga sinkronisasi lirik real-time di Layar Kunci dan Dynamic Island (hanya menggunakan keep-alive status kasar berdaya sangat rendah, dan tidak mengumpulkan atau mengunggah data lokasi)."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
